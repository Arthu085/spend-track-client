# API origin without a path, credentials, query, or fragment; trailing slashes are normalized away.
# HTTPS required except HTTP on localhost, 127.0.0.1, or [::1]. Public: Vite embeds it in the bundle.
VITE_API_URL=http://localhost:3000

# Application name shown in the browser tab and layouts, and its short mark for the collapsed sidebar.
VITE_APP_NAME=Spend Track
VITE_APP_MARK=ST

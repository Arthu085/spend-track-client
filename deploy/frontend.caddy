root * /srv/frontend/current/dist

@hashed_asset {
	path /assets/*
	file
}
handle @hashed_asset {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

@file path_regexp \.[^/]+$
handle @file {
	header Cache-Control "no-cache"
	file_server
}

handle {
	header Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
